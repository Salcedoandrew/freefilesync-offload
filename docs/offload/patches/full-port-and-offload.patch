diff --git a/FreeFileSync/Source/macos/smoke_copy.cpp b/FreeFileSync/Source/macos/smoke_copy.cpp
new file mode 100644
index 0000000..ed2a870
--- /dev/null
+++ b/FreeFileSync/Source/macos/smoke_copy.cpp
@@ -0,0 +1,80 @@
+// *****************************************************************************
+// * macOS port smoke test: does the AFS engine actually copy and verify on     *
+// * arm64 Darwin? Reads a source file, writes a destination through the same   *
+// * AbstractFileSystem the Offload mode will use, then byte-compares the two   *
+// * with fff::filesHaveSameContent() - the exact verification path FreeFileSync *
+// * already uses for "verify copied files".                                    *
+// *****************************************************************************
+
+#include <iostream>
+#include <chrono>
+
+#include "afs/native.h"
+#include "afs/abstract.h"
+#include "base/binary.h"
+
+using namespace fff;
+using AFS = AbstractFileSystem;
+
+static const zen::IoCallback noProgress = [](int64_t) {};
+
+int main(int argc, char** argv)
+{
+    if (argc != 3 && argc != 4)
+    {
+        std::cerr << "usage: smoke_copy <source> <destination>      copy then verify\n"
+                     "       smoke_copy --verify <a> <b>            verify only\n";
+        return 2;
+    }
+    const bool verifyOnly = (argc == 4 && std::string(argv[1]) == "--verify");
+    const Zstring srcPath = argv[verifyOnly ? 2 : 1];
+    const Zstring dstPath = argv[verifyOnly ? 3 : 2];
+
+    try
+    {
+        const AbstractPath src = createItemPathNative(srcPath);
+        const AbstractPath dst = createItemPathNative(dstPath);
+
+        const auto t0 = std::chrono::steady_clock::now();
+
+        uint64_t bytes = 0;
+        if (!verifyOnly)
+        {
+            const auto in  = AFS::getInputStream(src);                                  //throw FileError
+            const auto out = AFS::getOutputStream(dst, std::nullopt, std::nullopt);      //throw FileError
+
+            const size_t blockSize = in->getBlockSize();
+            std::unique_ptr<char[]> buf(new char[blockSize]);
+
+            for (;;)
+            {
+                const size_t n = in->tryRead(buf.get(), blockSize, noProgress); //0 == EOF
+                if (n == 0)
+                    break;
+                size_t written = 0;
+                while (written < n)
+                    written += out->tryWrite(buf.get() + written, n - written, noProgress);
+                bytes += n;
+            }
+            out->finalize(noProgress); //publishes via .ffs_tmp + rename
+        }
+
+        const bool same = filesHaveSameContent(src, dst, noProgress);
+        const auto dt = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+
+        std::cout << "copied  " << bytes << " bytes in " << dt << " s ("
+                  << (dt > 0 ? static_cast<double>(bytes) / dt / (1024 * 1024) : 0.0) << " MiB/s)\n";
+        std::cout << "verify  " << (same ? "IDENTICAL" : "MISMATCH") << "\n";
+        return same ? 0 : 1;
+    }
+    catch (const zen::FileError& e)
+    {
+        std::cerr << "FileError: " << zen::utfTo<std::string>(e.toString()) << "\n";
+        return 3;
+    }
+    catch (const std::exception& e)
+    {
+        std::cerr << "exception: " << e.what() << "\n";
+        return 4;
+    }
+}
diff --git a/FreeFileSync/Source/offload/capi.cpp b/FreeFileSync/Source/offload/capi.cpp
new file mode 100644
index 0000000..8df2142
--- /dev/null
+++ b/FreeFileSync/Source/offload/capi.cpp
@@ -0,0 +1,326 @@
+// *****************************************************************************
+// * Offload mode - C ABI over the C++ engine.                                  *
+// *                                                                            *
+// * One OffloadJob == one source -> destination transfer, running on its own   *
+// * thread. The UI polls a snapshot at whatever rate it likes and drives pause *
+// * and cancel through atomics; no C++ type crosses this boundary.             *
+// *****************************************************************************
+
+#include "capi.h"
+#include "engine.h"
+#include "report.h"
+
+#include <zen/file_access.h>
+#include <zen/file_error.h>
+#include <zen/file_path.h>
+
+#include <chrono>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <thread>
+
+using namespace zen;
+
+namespace
+{
+const char* const kEngineVersion = "0.2.0";
+
+std::string nowStamp()
+{
+    const std::time_t t = std::time(nullptr);
+    std::tm tmBuf{};
+    localtime_r(&t, &tmBuf);
+    char buf[32];
+    std::strftime(buf, sizeof(buf), "%Y%m%d-%H%M%S", &tmBuf);
+    return buf;
+}
+
+offload::HashAlgo toHashAlgo(int32_t v)
+{
+    switch (v)
+    {
+        case OFFLOAD_HASH_MD5:  return offload::HashAlgo::md5;
+        case OFFLOAD_HASH_SHA1: return offload::HashAlgo::sha1;
+    }
+    return offload::HashAlgo::xxh64;
+}
+} //namespace
+
+
+struct OffloadJob
+{
+    offload::Options opts;
+    std::atomic<bool> pauseFlag{ false };
+    std::atomic<bool> cancelFlag{ false };
+
+    std::thread worker;
+    std::chrono::steady_clock::time_point started = std::chrono::steady_clock::now();
+
+    //everything below is guarded by mu
+    std::mutex mu;
+    offload::Progress prog;
+    offload::JobReport report;
+    std::string currentFile;
+    std::string errorText;
+    std::string reportCsv;
+    bool haveReport = false;
+    bool finished = false;
+    uint64_t bytesWritten = 0;
+    uint64_t verifiedCount = 0;
+    uint64_t skippedCount = 0;
+    uint64_t failedCount = 0;
+    uint64_t fileCount = 0;
+
+    void publishProgress(const offload::Progress& p)
+    {
+        std::lock_guard<std::mutex> lk(mu);
+        prog = p;
+        currentFile = zen::utfTo<std::string>(p.currentFile);
+    }
+};
+
+
+extern "C" const char* offload_engine_version(void)
+{
+    return kEngineVersion;
+}
+
+
+namespace
+{
+//per-thread, so two panes measuring at the same time cannot overwrite each other
+thread_local std::string g_measureError;
+}
+
+
+extern "C" int32_t offload_source_measure(const char* source, uint64_t* outBytes, uint64_t* outFiles)
+{
+    g_measureError.clear();
+    if (!source || !*source)
+    {
+        g_measureError = "no source path";
+        return 0;
+    }
+
+    uint64_t bytes = 0;
+    size_t   files = 0;
+    std::string err;
+    if (!offload::measureSource(Zstring(source), bytes, files, err))
+    {
+        g_measureError = err.empty() ? "cannot read the source folder" : err;
+        return 0;
+    }
+
+    if (outBytes) *outBytes = bytes;
+    if (outFiles) *outFiles = static_cast<uint64_t>(files);
+    return 1;
+}
+
+
+extern "C" const char* offload_measure_error(void)
+{
+    return g_measureError.c_str();
+}
+
+
+extern "C" OffloadJob* offload_job_start(const char* source, const char* dest, const char* reportDir,
+                                         int32_t hashAlgo, int32_t verifyMode, int32_t dryRun)
+{
+    if (!source || !*source || !dest || !*dest)
+        return nullptr;
+
+    const Zstring sourcePath(source);
+    const Zstring destPath(dest);
+
+    //Fail here, with a message the UI can show, rather than inside the worker.
+    {
+        std::optional<ItemType> type;
+        try { type = getItemTypeIfExists(sourcePath); }
+        catch (const FileError& e)
+        {
+            auto* job = new OffloadJob;
+            job->errorText = "cannot read the source: " + zen::utfTo<std::string>(e.toString());
+            job->finished = true;
+            return job;
+        }
+        if (!type)
+        {
+            auto* job = new OffloadJob;
+            job->errorText = "the source folder is gone";
+            job->finished = true;
+            return job;
+        }
+        if (*type != ItemType::folder)
+        {
+            auto* job = new OffloadJob;
+            job->errorText = "the source must be a folder, not a single file";
+            job->finished = true;
+            return job;
+        }
+    }
+
+    auto* job = new OffloadJob;
+    job->opts.sourceRoot   = sourcePath;
+    job->opts.destRoots    = { destPath };
+    job->opts.hashAlgo     = toHashAlgo(hashAlgo);
+    job->opts.verify       = verifyMode == OFFLOAD_VERIFY_SIZE ? offload::VerifyMode::sizeOnly
+                                                              : offload::VerifyMode::sourceAndDest;
+    job->opts.dryRun       = dryRun != 0;
+    job->opts.pause        = &job->pauseFlag;
+    job->opts.cancel       = &job->cancelFlag;
+    job->opts.onProgress   = [job](const offload::Progress& p) { job->publishProgress(p); };
+
+    const std::string reportDirStr = reportDir ? reportDir : "";
+    job->started = std::chrono::steady_clock::now();
+
+    job->worker = std::thread([job, reportDirStr]()
+    {
+        offload::JobReport r;
+        std::string error;
+        try
+        {
+            r = offload::runJob(job->opts);
+        }
+        catch (const std::exception& e)
+        {
+            error = e.what();
+        }
+        catch (...)
+        {
+            error = "unknown engine failure";
+        }
+
+        //Reports are part of the deliverable, not an optional extra: the MHL goes
+        //to the destination (archive-interoperable) and CSV/JSON to the report dir.
+        std::string csvPath;
+        if (!reportDirStr.empty() && !r.dests.empty())
+        {
+            try { createDirectoryIfMissingRecursion(Zstring(reportDirStr.c_str())); }
+            catch (const FileError&) {}
+
+            const Zstring dir(reportDirStr.c_str());
+            const std::string e1 = offload::writeCsv (r, appendSeparator(dir) + Zstr("report.csv"));
+            const std::string e2 = offload::writeJson(r, appendSeparator(dir) + Zstr("report.json"));
+            if (!e1.empty() && error.empty()) error = "csv: " + e1;
+            if (!e2.empty() && error.empty()) error = "json: " + e2;
+            csvPath = zen::utfTo<std::string>(appendSeparator(dir) + Zstr("report.csv"));
+        }
+        for (const offload::DestReport& d : r.dests)
+            if (!d.destRoot.empty())
+                if (const std::string e = offload::writeMhl(r, d, appendSeparator(d.destRoot) + Zstr(".ffsoffload.mhl"));
+                    !e.empty() && error.empty())
+                    error = "mhl: " + e;
+
+        std::lock_guard<std::mutex> lk(job->mu);
+        job->report      = std::move(r);
+        job->haveReport  = true;
+        job->finished    = true;
+        job->reportCsv   = csvPath;
+        if (!error.empty())
+            job->errorText = error;
+
+        for (const offload::DestReport& d : job->report.dests)
+        {
+            job->bytesWritten  += d.bytesCopied;
+            job->verifiedCount += d.verified;
+            job->skippedCount  += d.skipped;
+            job->failedCount   += d.failed + d.mismatched;
+            job->fileCount     += d.files.size();
+        }
+    });
+
+    return job;
+}
+
+
+extern "C" void offload_job_poll(OffloadJob* job, OffloadProgress* out)
+{
+    if (!job || !out)
+        return;
+    std::lock_guard<std::mutex> lk(job->mu);
+
+    out->bytesDone        = job->prog.bytesDone;
+    out->bytesTotal       = job->prog.bytesTotal;
+    out->currentFileDone  = job->prog.currentFileDone;
+    out->currentFileSize  = job->prog.currentFileSize;
+    out->filesDone        = job->prog.filesDone;
+    out->filesTotal       = job->prog.filesTotal;
+    out->phase            = static_cast<int32_t>(job->prog.phase);
+    out->finished         = job->finished ? 1 : 0;
+    out->cancelled        = job->cancelFlag.load() ? 1 : 0;
+    out->bytesWritten     = job->finished ? job->bytesWritten : job->prog.bytesDone;
+    out->verifiedCount    = job->verifiedCount;
+    out->skippedCount     = job->skippedCount;
+    out->failedCount      = job->failedCount;
+    out->fileCount        = job->fileCount;
+    out->ok               = (job->finished && job->haveReport &&
+                             offload::allVerified(job->report) &&
+                             !job->report.cancelled &&
+                             job->errorText.empty()) ? 1 : 0;
+    out->elapsedSeconds   = std::chrono::duration<double>(std::chrono::steady_clock::now() - job->started).count();
+}
+
+
+extern "C" const char* offload_job_current_file(OffloadJob* job)
+{
+    if (!job)
+        return "";
+    std::lock_guard<std::mutex> lk(job->mu);
+    return job->currentFile.c_str();
+}
+
+
+extern "C" const char* offload_job_error(OffloadJob* job)
+{
+    if (!job)
+        return "";
+    std::lock_guard<std::mutex> lk(job->mu);
+    return job->errorText.c_str();
+}
+
+
+extern "C" const char* offload_job_report_csv(OffloadJob* job)
+{
+    if (!job)
+        return "";
+    std::lock_guard<std::mutex> lk(job->mu);
+    return job->reportCsv.c_str();
+}
+
+
+extern "C" void offload_job_pause(OffloadJob* job, int32_t paused)
+{
+    if (!job)
+        return;
+    job->pauseFlag.store(paused != 0);
+}
+
+
+extern "C" int32_t offload_job_paused(OffloadJob* job)
+{
+    return job && job->pauseFlag.load() ? 1 : 0;
+}
+
+
+extern "C" void offload_job_cancel(OffloadJob* job)
+{
+    if (!job)
+        return;
+    job->cancelFlag.store(true);
+    job->pauseFlag.store(false); //a paused worker must still wake up to see the cancel
+}
+
+
+extern "C" void offload_job_destroy(OffloadJob* job)
+{
+    if (!job)
+        return;
+    if (job->worker.joinable())
+    {
+        job->cancelFlag.store(true);
+        job->pauseFlag.store(false);
+        job->worker.join();
+    }
+    delete job;
+}
diff --git a/FreeFileSync/Source/offload/capi.h b/FreeFileSync/Source/offload/capi.h
new file mode 100644
index 0000000..a8700a0
--- /dev/null
+++ b/FreeFileSync/Source/offload/capi.h
@@ -0,0 +1,103 @@
+// *****************************************************************************
+// * Offload mode - C ABI over the C++ engine.                                  *
+// *                                                                            *
+// * The window is a native macOS app; Swift cannot call C++ directly, so this  *
+// * is the only boundary between the UI and the engine. Everything here is a  *
+// * plain C value or an opaque handle, and no C++ type appears in a signature. *
+// *****************************************************************************
+#ifndef OFFLOAD_CAPI_H
+#define OFFLOAD_CAPI_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+//Mirrors offload::HashAlgo / offload::VerifyMode.
+enum
+{
+    OFFLOAD_HASH_XXH64 = 0,
+    OFFLOAD_HASH_MD5   = 1,
+    OFFLOAD_HASH_SHA1  = 2,
+};
+
+enum
+{
+    OFFLOAD_VERIFY_SIZE = 0,
+    OFFLOAD_VERIFY_HASH = 1,
+};
+
+//Mirrors offload::Progress::Phase.
+enum
+{
+    OFFLOAD_PHASE_SCANNING  = 0,
+    OFFLOAD_PHASE_COPYING   = 1,
+    OFFLOAD_PHASE_VERIFYING = 2,
+    OFFLOAD_PHASE_DONE      = 3,
+};
+
+typedef struct OffloadJob OffloadJob;
+
+typedef struct
+{
+    uint64_t bytesDone;      //written, or hashed back, across the whole transfer
+    uint64_t bytesTotal;     //planned bytes; 0 until the source has been scanned
+    uint64_t currentFileDone;
+    uint64_t currentFileSize;
+    uint64_t filesDone;
+    uint64_t filesTotal;
+    uint64_t bytesWritten;   //bytes this run actually put on the destination
+    int32_t  phase;          //OFFLOAD_PHASE_*
+    int32_t  finished;       //1 once the worker thread returned
+    int32_t  ok;             //1 only if finished and every file verified
+    int32_t  cancelled;
+    uint64_t verifiedCount;
+    uint64_t skippedCount;
+    uint64_t failedCount;    //failed + mismatch
+    uint64_t fileCount;
+    double   elapsedSeconds;
+} OffloadProgress;
+
+//Starts one source -> destination transfer on its own thread and returns at once.
+//reportDir may be NULL (no reports) or a directory that already exists.
+//Returns NULL if the source cannot be opened; offload_job_error() then explains why.
+OffloadJob* offload_job_start(const char* source, const char* dest, const char* reportDir,
+                              int32_t hashAlgo, int32_t verifyMode, int32_t dryRun);
+
+//Copies the latest snapshot into *out. Safe to call from any thread, as often as
+//the caller likes; safe before and after the worker finishes.
+void offload_job_poll(OffloadJob* job, OffloadProgress* out);
+
+//Relative path of the file being worked on, UTF-8. Valid until the next call.
+const char* offload_job_current_file(OffloadJob* job);
+
+//Human-readable reason for a start failure or a failed run, UTF-8. "" when fine.
+const char* offload_job_error(OffloadJob* job);
+
+//Path of the CSV report written for a finished job, UTF-8, or "" if none.
+const char* offload_job_report_csv(OffloadJob* job);
+
+void offload_job_pause (OffloadJob* job, int32_t paused); //takes effect between blocks
+int32_t offload_job_paused(OffloadJob* job);
+void offload_job_cancel(OffloadJob* job); //finishes the file in flight, then stops
+
+//Cancels if still running, joins the worker thread and frees the handle. Never
+//blocks for longer than the file currently in flight takes to finish.
+void offload_job_destroy(OffloadJob* job);
+
+//Bytes and file count a transfer from this folder would carry, using the engine's
+//own walk and junk rules. Returns 1 on success, 0 on failure (see
+//offload_measure_error). Worth calling on a background thread: it walks the tree.
+int32_t offload_source_measure(const char* source, uint64_t* outBytes, uint64_t* outFiles);
+
+//Why the last measure call on this thread failed, UTF-8. "" when it succeeded.
+const char* offload_measure_error(void);
