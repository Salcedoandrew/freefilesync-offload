diff --git a/FreeFileSync/Source/offload/mac/clickdriver.swift b/FreeFileSync/Source/offload/mac/clickdriver.swift
new file mode 100644
index 0000000..5815551
--- /dev/null
+++ b/FreeFileSync/Source/offload/mac/clickdriver.swift
@@ -0,0 +1,191 @@
+// *****************************************************************************
+// * Offload window - external mouse driver.                                   *
+// *                                                                           *
+// * SwiftUI ignores synthetic NSEvents handed to its hosting view, so this     *
+// * posts real CGEvents at the positions the window published, then checks     *
+// * what changed in that published state. Needs Accessibility permission for   *
+// * the process that posts (System Settings -> Privacy & Security).            *
+// *                                                                           *
+// *   clickdriver --state /tmp/offload-ui.json                                 *
+// *****************************************************************************
+
+import AppKit
+import CoreGraphics
+
+struct Snapshot
+{
+    var anchors: [String: CGPoint] = [:]
+    var selectedSources = 0
+    var selectedDestinations = 0
+    var canAddTransfer = false
+    var transfers: [[String: Any]] = []
+    var pid: pid_t = 0
+
+    func flag(_ row: Int, _ key: String) -> Bool
+    {
+        guard row < transfers.count else { return false }
+        return (transfers[row][key] as? Bool) ?? false
+    }
+}
+
+func loadState(_ path: String) -> Snapshot?
+{
+    guard let data = try? Data(contentsOf: URL(fileURLWithPath: path)),
+          let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+    else { return nil }
+
+    var snapshot = Snapshot()
+    snapshot.selectedSources = root["selectedSources"] as? Int ?? 0
+    snapshot.selectedDestinations = root["selectedDestinations"] as? Int ?? 0
+    snapshot.canAddTransfer = root["canAddTransfer"] as? Bool ?? false
+    snapshot.transfers = root["transfers"] as? [[String: Any]] ?? []
+    snapshot.pid = pid_t(root["pid"] as? Int ?? 0)
+
+    if let anchors = root["anchors"] as? [String: [String: Double]]
+    {
+        for (id, rect) in anchors
+        {
+            if let x = rect["x"], let y = rect["y"] { snapshot.anchors[id] = CGPoint(x: x, y: y) }
+        }
+    }
+    return snapshot
+}
+
+func waitForState(_ path: String, timeout: Double = 15,
+                  _ predicate: (Snapshot) -> Bool) -> Snapshot?
+{
+    let deadline = Date().addingTimeInterval(timeout)
+    while Date() < deadline
+    {
+        if let snapshot = loadState(path), predicate(snapshot) { return snapshot }
+        Thread.sleep(forTimeInterval: 0.1)
+    }
+    return loadState(path)
+}
+
+///A real hardware-level click at a global display point (top-left origin).
+func click(_ point: CGPoint)
+{
+    let source = CGEventSource(stateID: .hidSystemState)
+    let move = CGEvent(mouseEventSource: source, mouseType: .mouseMoved,
+                       mouseCursorPosition: point, mouseButton: .left)
+    let down = CGEvent(mouseEventSource: source, mouseType: .leftMouseDown,
+                       mouseCursorPosition: point, mouseButton: .left)
+    let up = CGEvent(mouseEventSource: source, mouseType: .leftMouseUp,
+                     mouseCursorPosition: point, mouseButton: .left)
+    move?.post(tap: .cghidEventTap)
+    Thread.sleep(forTimeInterval: 0.05)
+    down?.post(tap: .cghidEventTap)
+    Thread.sleep(forTimeInterval: 0.08)
+    up?.post(tap: .cghidEventTap)
+}
+
+let args = CommandLine.arguments
+guard let flagIndex = args.firstIndex(of: "--state"), flagIndex + 1 < args.count else
+{
+    print("usage: clickdriver --state <state.json>")
+    exit(2)
+}
+let statePath = args[flagIndex + 1]
+
+guard let firstState = waitForState(statePath,
+                                   { $0.anchors["src-tile-0"] != nil && $0.anchors["dst-tile-1"] != nil })
+else
+{
+    print("FAIL: the window never published a state file at \(statePath)")
+    exit(2)
+}
+var snapshot = firstState
+
+print("driver: app pid \(snapshot.pid), \(snapshot.anchors.count) click targets published")
+NSRunningApplication(processIdentifier: snapshot.pid)?.activate(options: [.activateIgnoringOtherApps])
+Thread.sleep(forTimeInterval: 0.8)
+
+var checks = 0
+var failures = 0
+
+func check(_ ok: Bool, _ what: String)
+{
+    checks += 1
+    if ok { print("   ok   \(what)") }
+    else  { failures += 1; print("   FAIL \(what)") }
+}
+
+func clickAnchor(_ id: String)
+{
+    guard let point = loadState(statePath)?.anchors[id] else
+    {
+        print("   FAIL no click target named \(id)")
+        failures += 1
+        return
+    }
+    NSRunningApplication(processIdentifier: snapshot.pid)?.activate(options: [.activateIgnoringOtherApps])
+    Thread.sleep(forTimeInterval: 0.15)
+    click(point)
+    Thread.sleep(forTimeInterval: 0.55)
+    print(String(format: "   click %@ at (%.0f, %.0f)", id, point.x, point.y))
+}
+
+//--- 0. normalise: the panes preselect devices when they are dropped in -------
+snapshot = loadState(statePath) ?? snapshot
+var guardCount = 0
+while (snapshot.selectedSources > 0 || snapshot.selectedDestinations > 0) && guardCount < 6
+{
+    if snapshot.selectedSources > 0 { clickAnchor("src-tile-0") }
+    if let current = loadState(statePath), current.selectedDestinations > 0
+    {
+        clickAnchor("dst-tile-0")
+        if let again = loadState(statePath), again.selectedDestinations > 0 { clickAnchor("dst-tile-1") }
+    }
+    snapshot = loadState(statePath) ?? snapshot
+    guardCount += 1
+}
+check(snapshot.selectedSources == 0 && snapshot.selectedDestinations == 0,
+      "clicks cleared the preselected devices")
+
+//--- 1. source tile ----------------------------------------------------------
+clickAnchor("src-tile-0")
+check(loadState(statePath)?.selectedSources == 1, "clicking a source tile selects it")
+
+clickAnchor("src-tile-0")
+check(loadState(statePath)?.selectedSources == 0, "clicking it again deselects it")
+
+clickAnchor("src-tile-0")
+
+//--- 2. destinations ---------------------------------------------------------
+clickAnchor("dst-tile-0")
+check(loadState(statePath)?.selectedDestinations == 1, "clicking a destination tile selects it")
+
+clickAnchor("dst-tile-1")
+check(loadState(statePath)?.selectedDestinations == 2, "a second destination adds to the selection")
+
+//--- 3. Add Transfers --------------------------------------------------------
+clickAnchor("add-transfers")
+snapshot = loadState(statePath) ?? snapshot
+check(snapshot.transfers.count == 2, "Add Transfers created one row per destination (got \(snapshot.transfers.count))")
+
+//--- 4. per-row pause, resume, cancel ---------------------------------------
+clickAnchor("row-0-pause")
+check(loadState(statePath)?.flag(0, "enginePaused") == true, "the row's pause button paused that job in the engine")
+
+clickAnchor("row-0-pause")
+check(loadState(statePath)?.flag(0, "enginePaused") == false, "clicking it again resumed the job")
+
+clickAnchor("row-0-cancel")
+check(loadState(statePath)?.flag(0, "engineCancelled") == true, "the row's cancel button reached the engine")
+
+//--- 5. Add with nothing selected does nothing --------------------------------
+let rowsBefore = loadState(statePath)?.transfers.count ?? 0
+clickAnchor("dst-tile-0")
+clickAnchor("dst-tile-1")
+check(loadState(statePath)?.selectedDestinations == 0, "both destinations are now deselected")
+
+clickAnchor("add-transfers")
+check(loadState(statePath)?.transfers.count == rowsBefore, "Add does nothing when nothing is selected")
+
+clickAnchor("dst-tile-0")
+check(loadState(statePath)?.selectedDestinations == 1, "the window still responds after that")
+
+print("")
+print("\(checks - failures)/\(checks) mouse checks passed")
+exit(failures == 0 ? 0 : 1)
diff --git a/FreeFileSync/Source/offload/main.cpp b/FreeFileSync/Source/offload/main.cpp
new file mode 100644
index 0000000..cc8f74f
--- /dev/null
+++ b/FreeFileSync/Source/offload/main.cpp
@@ -0,0 +1,326 @@
+// *****************************************************************************
+// * ffsoffload - verified media offload for camera cards.                      *
+// *                                                                            *
+// *   ffsoffload --source /Volumes/CARD --dest /Volumes/A --dest /Volumes/B    *
+// *                                                                            *
+// * Copies to every destination in parallel, hashes with XXH64 while writing,  *
+// * reads every copy back and compares, then writes an MHL per destination     *
+// * plus a CSV/JSON log. The source is never modified.                         *
+// *****************************************************************************
+
+#include "engine.h"
+#include "report.h"
+
+#include <zen/file_access.h>
+#include <zen/file_path.h>
+#include <zen/utf.h>
+
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <thread>
+#include <vector>
+
+using namespace offload;
+
+namespace
+{
+//Workers read these; the signal handler only sets the plain flag below, because
+//only `volatile sig_atomic_t` is safe to touch from a handler.
+std::atomic<bool> g_pause{ false };
+std::atomic<bool> g_cancel{ false };
+std::atomic<bool> g_done{ false };
+volatile sig_atomic_t g_pauseSignal = 0;
+
+//SIGUSR1 toggles pause, SIGINT/SIGTERM cancel after the file in flight.
+extern "C" void onSignal(int sig)
+{
+    if (sig == SIGUSR1)
+        g_pauseSignal = !g_pauseSignal;
+    else
+        g_cancel.store(true);
+}
+
+void installSignalHandlers()
+{
+    std::signal(SIGUSR1, onSignal);
+    std::signal(SIGINT,  onSignal);
+    std::signal(SIGTERM, onSignal);
+}
+
+//Turns the signal-flag into the atomic the engine polls, once per 50 ms.
+std::thread startSignalBridge()
+{
+    return std::thread([]()
+    {
+        while (!g_done.load())
+        {
+            static sig_atomic_t seen = 0;
+            if (g_pauseSignal != seen)
+            {
+                seen = g_pauseSignal;
+                g_pause.store(seen != 0);
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
+    });
+}
+
+void printUsage()
+{
+    std::cout <<
+        "ffsoffload - verified offload of a camera card to one or more destinations\n"
+        "\n"
+        "  ffsoffload --source DIR --dest DIR [--dest DIR ...] [options]\n"
+        "\n"
+        "Options:\n"
+        "  --source DIR        folder or card to read from (never modified)\n"
+        "  --dest DIR          destination root (repeat for every copy)\n"
+        "  --verify MODE       'hash' (default, read back and compare hashes)\n"
+        "                      or 'size' (compare sizes only, much weaker)\n"
+        "  --hash ALGO         xxh64 (default) | md5 | sha1 - used for verification\n"
+        "                      and reported in the CSV/JSON/MHL\n"
+        "  --reverify          do not copy; hash what is already on the destinations\n"
+        "                      and report mismatches\n"
+        "  --dry-run           plan and report, write nothing\n"
+        "  --report DIR        also write report.csv and report.json here\n"
+        "  --mhl               write <destination>/.ffsoffload.mhl at each destination root\n"
+        "  --quiet             only print the summary and failures\n"
+        "  --json              print the summary as JSON\n"
+        "\n"
+        "Signals: SIGUSR1 pauses and resumes, SIGINT/SIGTERM cancel after the\n"
+        "         file in flight (already-published files stay verified)\n"
+        "\n"
+        "Exit codes: 0 all copies verified, 1 mismatch or failure, 2 bad usage\n";
+}
+
+struct Args
+{
+    Zstring source;
+    std::vector<Zstring> dests;
+    VerifyMode verify = VerifyMode::sourceAndDest;
+    bool reverify = false;
+    bool dryRun   = false;
+    bool writeMhl = false;
+    bool quiet    = false;
+    bool json     = false;
+    HashAlgo hash = HashAlgo::xxh64;
+    Zstring reportDir;
+};
+
+bool parseArgs(int argc, char** argv, Args& out, std::string& err)
+{
+    for (int i = 1; i < argc; ++i)
+    {
+        const std::string a = argv[i];
+        const auto next = [&](Zstring& target) -> bool
+        {
+            if (i + 1 >= argc) { err = "missing value for " + a; return false; }
+            target = argv[++i];
+            return true;
+        };
+
+        if (a == "--source")        { if (!next(out.source)) return false; }
+        else if (a == "--dest")     { Zstring d; if (!next(d)) return false; out.dests.push_back(d); }
+        else if (a == "--report")   { if (!next(out.reportDir)) return false; }
+        else if (a == "--verify")
+        {
+            Zstring mode;
+            if (!next(mode)) return false;
+            if (mode == Zstr("hash"))      out.verify = VerifyMode::sourceAndDest;
+            else if (mode == Zstr("size")) out.verify = VerifyMode::sizeOnly;
+            else { err = "unknown --verify mode: " + zen::utfTo<std::string>(mode); return false; }
+        }
+        else if (a == "--hash")
+        {
+            Zstring algo;
+            if (!next(algo)) return false;
+            if (!parseHashAlgo(zen::utfTo<std::string>(algo), out.hash))
+            {
+                err = "unknown --hash algorithm: " + zen::utfTo<std::string>(algo) + " (xxh64|md5|sha1)";
+                return false;
+            }
+        }
+        else if (a == "--reverify") out.reverify = true;
+        else if (a == "--dry-run")  out.dryRun   = true;
+        else if (a == "--mhl")      out.writeMhl = true;
+        else if (a == "--quiet")    out.quiet    = true;
+        else if (a == "--json")     out.json     = true;
+        else if (a == "-h" || a == "--help") { printUsage(); std::exit(0); }
+        else { err = "unknown option: " + a; return false; }
+    }
+    if (out.source.empty())      { err = "--source is required";  return false; }
+    if (out.dests.empty())       { err = "at least one --dest is required"; return false; }
+    if (out.reverify && out.dryRun) { err = "--reverify and --dry-run contradict each other"; return false; }
+    return true;
+}
+
+std::string destLabel(const Zstring& path)
+{
+    std::string s = zen::utfTo<std::string>(path);
+    while (!s.empty() && (s.back() == '/' || s.back() == '\\'))
+        s.pop_back();
+    const size_t sep = s.find_last_of("/\\");
+    return sep == std::string::npos ? s : s.substr(sep + 1);
+}
+} //namespace
+
+
+int main(int argc, char** argv)
+{
+    Args args;
+    std::string err;
+    if (!parseArgs(argc, argv, args, err))
+    {
+        std::cerr << "ffsoffload: " << err << "\n\n";
+        printUsage();
+        return 2;
+    }
+
+    //fail early on an unusable source instead of after a scan
+    try
+    {
+        if (!zen::itemExists(args.source))
+        {
+            std::cerr << "ffsoffload: source does not exist: " << zen::utfTo<std::string>(args.source) << "\n";
+            return 2;
+        }
+    }
+    catch (const zen::FileError& e)
+    {
+        std::cerr << "ffsoffload: " << zen::utfTo<std::string>(e.toString()) << "\n";
+        return 2;
+    }
+
+    Options opts;
+    opts.sourceRoot = args.source;
+    opts.destRoots  = args.dests;
+    opts.verify     = args.verify;
+    opts.hashAlgo   = args.hash;
+    opts.dryRun     = args.dryRun;
+    opts.reverifyOnly = args.reverify;
+    opts.cancel     = &g_cancel;
+    opts.pause      = &g_pause;
+
+    installSignalHandlers();
+    std::thread signalBridge = startSignalBridge();
+
+    std::thread pauseMonitor;
+    if (!args.quiet)
+        pauseMonitor = std::thread([]() //printing lives on its own thread
+    {
+            bool announced = false;
+            for (;;)
+            {
+                if (g_done.load())
+                    return;
+                const bool paused = g_pause.load();
+                if (paused != announced)
+                {
+                    announced = paused;
+                    std::cout << (paused ? "\n-- paused (SIGUSR1 to resume) --\n"
+                                         : "\n-- resumed --\n") << std::flush;
+                }
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            }
+        });
+
+    const auto start = std::chrono::steady_clock::now();
+
+    if (!args.quiet)
+    {
+        std::cout << "source  " << zen::utfTo<std::string>(args.source) << "\n";
+        for (const Zstring& d : args.dests)
+            std::cout << "dest    " << zen::utfTo<std::string>(d) << "\n";
+        std::cout << "verify  " << getVerifyModeName(args.verify)
+                  << (args.reverify ? " (re-verify only)" : "") << "\n";
+        std::cout << "hash    " << getAlgoName(args.hash) << "\n\n";
+    }
+
+    size_t filesSeen = 0;
+    opts.onFileDone = [&](const Zstring& destRoot, const FileRecord& f)
+    {
+        ++filesSeen;
+        if (args.quiet)
+            return;
+        std::cout << "  " << destLabel(destRoot) << "  " << getStateName(f.state)
+                  << "  " << humanBytes(f.size) << "  " << zen::utfTo<std::string>(f.relPath);
+        if (!f.error.empty())
+            std::cout << "  [" << f.error << "]";
+        std::cout << "\n";
+    };
+
+    const JobReport job = runJob(opts);
+    g_done.store(true);
+    if (pauseMonitor.joinable())
+        pauseMonitor.join();
+    if (signalBridge.joinable())
+        signalBridge.join();
+
+    const auto elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+
+    if (args.json)
+    {
+        std::cout << "{\"ok\": " << (allVerified(job) ? "true" : "false")
+                  << ", \"files\": " << totalFiles(job)
+                  << ", \"seconds\": " << elapsed;
+        for (const DestReport& d : job.dests)
+            std::cout << ", \"" << destLabel(d.destRoot) << "\": {\"verified\": " << d.verified
+                      << ", \"written\": " << d.filesWritten << ", \"skipped\": " << d.skipped
+                      << ", \"mismatch\": " << d.mismatched << ", \"failed\": " << d.failed << "}";
+        std::cout << "}\n";
+    }
+    else
+    {
+        std::cout << "\n";
+        for (const DestReport& d : job.dests)
+        {
+            std::cout << destLabel(d.destRoot) << ": "
+                      << d.verified << " verified, "
+                      << d.filesWritten << " written, "
+                      << d.skipped << " already present, "
+                      << d.mismatched << " mismatch, "
+                      << d.failed << " failed  ("
+                      << humanBytes(d.bytesCopied) << " written)\n";
+
+            for (const FileRecord& f : d.files)
+                if (isFailure(f.state))
+                    std::cout << "  FAIL " << zen::utfTo<std::string>(f.relPath)
+                              << "  [" << getStateName(f.state) << "] " << f.error << "\n";
+        }
+        std::cout << (allVerified(job) ? "OK: every file verified\n" : "FAILED: see failures above\n");
+        std::cout << "elapsed " << elapsed << " s for " << totalFiles(job) << " file copies\n";
+    }
+
+    //artefacts
+    std::vector<std::string> reportErrors;
+    if (args.reportDir.empty())
+    {
+        if (!args.dryRun)
+            for (const DestReport& d : job.dests)
+                if (args.writeMhl)
+                    if (const std::string e = writeMhl(job, d, zen::appendSeparator(d.destRoot) + Zstr(".ffsoffload.mhl")); !e.empty())
+                        reportErrors.push_back(e);
+    }
+    else
+    {
+        try { zen::createDirectoryIfMissingRecursion(args.reportDir); } catch (const zen::FileError&) {}
+        const std::string e1 = writeCsv (job, zen::appendSeparator(args.reportDir) + Zstr("report.csv"));
+        const std::string e2 = writeJson(job, zen::appendSeparator(args.reportDir) + Zstr("report.json"));
+        if (!e1.empty()) reportErrors.push_back(e1);
+        if (!e2.empty()) reportErrors.push_back(e2);
+        if (args.writeMhl)
+            for (const DestReport& d : job.dests)
+                if (const std::string e = writeMhl(job, d, zen::appendSeparator(d.destRoot) + Zstr(".ffsoffload.mhl")); !e.empty())
+                    reportErrors.push_back(e);
+    }
+
+    for (const std::string& e : reportErrors)
+        std::cerr << "warning: could not write report: " << e << "\n";
+
+    return allVerified(job) ? 0 : 1;
+}
diff --git a/FreeFileSync/Source/offload/report.cpp b/FreeFileSync/Source/offload/report.cpp
new file mode 100644
index 0000000..6f7913d
--- /dev/null
+++ b/FreeFileSync/Source/offload/report.cpp
@@ -0,0 +1,220 @@
+// *****************************************************************************
+// * Offload mode for FreeFileSync - report writers.                            *
+// *****************************************************************************
+#include "report.h"
+#include "hash.h"
+
+#include <zen/file_error.h>
+#include <zen/file_io.h>
+#include <zen/sys_info.h>
+#include <zen/utf.h>
+
+#include <cstdio>
+#include <sstream>
+
+using namespace zen;
+
+namespace offload
+{
+namespace
+{
+const zen::IoCallback noProgress = [](int64_t) {};
+
+std::string csvEscape(const std::string& s)
+{
+    if (s.find_first_of(",\"\n\r") == std::string::npos)
+        return s;
+    std::string out = "\"";
+    for (char c : s)
+    {
+        if (c == '"')
+            out += '"';
+        out += c;
+    }
+    return out + '"';
+}
+
+std::string jsonEscape(const std::string& s)
+{
+    std::string out;
+    out.reserve(s.size() + 8);
+    for (unsigned char c : s)
+    {
+        switch (c)
+        {
+            case '"':  out += "\\\""; break;
+            case '\\': out += "\\\\"; break;
+            case '\n': out += "\\n";  break;
+            case '\r': out += "\\r";  break;
+            case '\t': out += "\\t";  break;
+            default:
+                if (c < 0x20)
+                {
+                    char buf[7];
+                    std::snprintf(buf, sizeof buf, "\\u%04x", c);
+                    out += buf;
+                }
+                else
+                    out += static_cast<char>(c);
+        }
+    }
+    return out;
+}
+
+std::string xmlEscape(const std::string& s)
+{
+    std::string out;
+    out.reserve(s.size() + 8);
+    for (char c : s)
+    {
+        switch (c)
+        {
+            case '&': out += "&amp;";  break;
+            case '<': out += "&lt;";   break;
+            case '>': out += "&gt;";   break;
+            case '"': out += "&quot;"; break;
+            case '\'': out += "&apos;"; break;
+            default: out += c;
+        }
+    }
+    return out;
+}
+
+std::string writeRaw(const Zstring& path, const std::string& content)
+{
+    try
+    {
+        setFileContent(path, content, noProgress); //throw FileError
+        return std::string();
+    }
+    catch (const FileError& e) { return zen::utfTo<std::string>(e.toString()); }
+}
+} //namespace
+
+
+std::string toIso8601(time_t t)
+{
+    std::tm tm{};
+#if defined(_WIN32)
+    gmtime_s(&tm, &t);
+#else
+    gmtime_r(&t, &tm);
+#endif
+    char buf[32];
+    std::strftime(buf, sizeof buf, "%Y-%m-%dT%H:%M:%SZ", &tm);
+    return buf;
+}
+
+std::string humanBytes(uint64_t bytes)
+{
+    const char* units[] = { "B", "KiB", "MiB", "GiB", "TiB" };
+    double v = static_cast<double>(bytes);
+    int u = 0;
+    while (v >= 1024.0 && u < 4)
+    {
+        v /= 1024.0;
+        ++u;
+    }
+    char buf[64];
+    std::snprintf(buf, sizeof buf, "%.1f %s", v, units[u]);
+    return buf;
+}
+
+
+std::string writeCsv(const JobReport& job, const Zstring& filePath)
+{
+    std::ostringstream out;
+    out << "destination,relative_path,size_bytes,modified_epoch,hash_"
+        << getHashTag(job.hashAlgo) << ",state,error\n";
+    for (const DestReport& d : job.dests)
+        for (const FileRecord& f : d.files)
+        {
+            out << csvEscape(zen::utfTo<std::string>(d.destRoot)) << ','
+                << csvEscape(zen::utfTo<std::string>(f.relPath)) << ','
+                << f.size << ','
+                << static_cast<long long>(f.modTime) << ','
+                << f.hash << ','
+                << getStateName(f.state) << ','
+                << csvEscape(f.error) << '\n';
+        }
+    return writeRaw(filePath, out.str());
+}
+
+
+std::string writeJson(const JobReport& job, const Zstring& filePath)
+{
+    std::ostringstream out;
+    out << "{\n";
+    out << "  \"tool\": \"ffsoffload " << job.toolVersion << "\",\n";
+    out << "  \"source\": \"" << jsonEscape(zen::utfTo<std::string>(job.sourceRoot)) << "\",\n";
+    out << "  \"verification\": \"" << jsonEscape(job.verifyMode) << "\",\n";
+    out << "  \"hash_algorithm\": \"" << getAlgoName(job.hashAlgo) << "\",\n";
+    out << "  \"started_at\": \"" << toIso8601(job.startedAt) << "\",\n";
+    out << "  \"finished_at\": \"" << toIso8601(job.finishedAt) << "\",\n";
+    out << "  \"cancelled\": " << (job.cancelled ? "true" : "false") << ",\n";
+    out << "  \"dry_run\": " << (job.dryRun ? "true" : "false") << ",\n";
+    out << "  \"reverify_only\": " << (job.reverifyOnly ? "true" : "false") << ",\n";
+    out << "  \"destinations\": [\n";
+
+    for (size_t i = 0; i < job.dests.size(); ++i)
+    {
+        const DestReport& d = job.dests[i];
+        out << "    {\n";
+        out << "      \"path\": \"" << jsonEscape(zen::utfTo<std::string>(d.destRoot)) << "\",\n";
+        out << "      \"bytes_copied\": " << d.bytesCopied << ",\n";
+        out << "      \"counts\": { \"copied\": " << d.copied << ", \"already_present\": " << d.skipped
+            << ", \"verified\": " << d.verified << ", \"mismatch\": " << d.mismatched
+            << ", \"failed\": " << d.failed << " },\n";
+        out << "      \"files\": [\n";
+        for (size_t k = 0; k < d.files.size(); ++k)
+        {
+            const FileRecord& f = d.files[k];
+            out << "        { \"path\": \"" << jsonEscape(zen::utfTo<std::string>(f.relPath)) << "\""
+                << ", \"size\": " << f.size
+                << ", \"modified\": " << static_cast<long long>(f.modTime)
+                << ", \"hash\": \"" << f.hash << "\""
+                << ", \"state\": \"" << getStateName(f.state) << "\"";
+            if (!f.error.empty())
+                out << ", \"error\": \"" << jsonEscape(f.error) << "\"";
+            out << " }" << (k + 1 < d.files.size() ? "," : "") << "\n";
+        }
+        out << "      ]\n";
+        out << "    }" << (i + 1 < job.dests.size() ? "," : "") << "\n";
+    }
+    out << "  ]\n}\n";
+    return writeRaw(filePath, out.str());
+}
+
+
+std::string writeMhl(const JobReport& job, const DestReport& dest, const Zstring& filePath)
+{
+    std::ostringstream out;
+    out << "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
+    out << "<hashlist version=\"1.1\">\n";
+    out << "  <creatorinfo>\n";
+    out << "    <creationdate>" << toIso8601(job.finishedAt) << "</creationdate>\n";
+    out << "    <hostname>" << xmlEscape(zen::utfTo<std::string>(zen::getHostName())) << "</hostname>\n";
+    out << "    <tool>ffsoffload</tool>\n";
+    out << "    <version>" << job.toolVersion << "</version>\n";
+    out << "    <source>" << xmlEscape(zen::utfTo<std::string>(job.sourceRoot)) << "</source>\n";
+    out << "    <verification>" << xmlEscape(job.verifyMode) << "</verification>\n";
+    out << "  </creatorinfo>\n";
+    out << "  <hashlist>\n";
+    out << "    <hashes>\n";
+    for (const FileRecord& f : dest.files)
+    {
+        if (f.hash.empty())
+            continue; //skipped files have no digest of ours; they are listed in the CSV/JSON log
+        out << "      <hash>\n";
+        out << "        <file>" << xmlEscape(zen::utfTo<std::string>(f.relPath)) << "</file>\n";
+        out << "        <size>" << f.size << "</size>\n";
+        const std::string tag = getHashTag(job.hashAlgo);
+        out << "        <" << tag << ">" << f.hash << "</" << tag << ">\n";
+        out << "      </hash>\n";
+    }
+    out << "    </hashes>\n";
+    out << "  </hashlist>\n";
+    out << "</hashlist>\n";
+    return writeRaw(filePath, out.str());
+}
+}
diff --git a/FreeFileSync/Source/offload/report.h b/FreeFileSync/Source/offload/report.h
