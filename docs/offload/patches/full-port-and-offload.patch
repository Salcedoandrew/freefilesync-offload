+    }
+
+    private var emptyState: some View
+    {
+        VStack(spacing: 10)
+        {
+            Spacer()
+            Image(systemName: "arrow.right.square")
+                .font(.system(size: 26, weight: .ultraLight))
+                .foregroundColor(Theme.textTertiary)
+            Text("No transfers yet")
+                .font(Theme.rowTitle)
