+                    Image(systemName: "arrow.right")
+                        .font(.system(size: 8, weight: .semibold))
+                        .foregroundColor(Theme.textTertiary)
+
+                    Text(transfer.destination.name)
+                        .font(Theme.rowBold)
+                        .foregroundColor(Theme.textPrimary)
+                        .lineLimit(1)
