+// *****************************************************************************
+// * Offload window - colours and metrics.                                     *
+// *                                                                           *
+// * One place for the palette so the window reads as one surface: near-black   *
+// * greys for structure, saturated green for verified, blue for moving bytes.   *
+// *****************************************************************************
+
+import SwiftUI
+
+extension Color
+{
+    init(hex: UInt32, alpha: Double = 1)
+    {
+        self.init(.sRGB,
+                  red:   Double((hex >> 16) & 0xFF) / 255,
+                  green: Double((hex >>  8) & 0xFF) / 255,
+                  blue:  Double( hex        & 0xFF) / 255,
+                  opacity: alpha)
+    }
+}
+
+enum Theme
+{
+    static let windowBG     = Color(hex: 0x121315)
+    static let paneBG       = Color(hex: 0x181A1C)
+    static let columnBG     = Color(hex: 0x1B1D20)
+    static let stroke       = Color(hex: 0x2A2C30)
+    static let strokeSoft   = Color(hex: 0x232528)
+
+    static let textPrimary   = Color(hex: 0xE9EBEE)
+    static let textSecondary = Color(hex: 0x8C9199)
+    static let textTertiary  = Color(hex: 0x676C74)
+
+    static let track    = Color(hex: 0x282A2E)
+    static let green    = Color(hex: 0x3ED94D)
+    static let greenDim = Color(hex: 0x2FA83B)
+    static let blue     = Color(hex: 0x1B7BF5)
+    static let blueDim  = Color(hex: 0x0A57C4)
+    static let amber    = Color(hex: 0xFFB020)
+    static let red      = Color(hex: 0xFF453A)
+
+    static let buttonBG   = Color(hex: 0x2C2F33)
+    static let buttonBG2  = Color(hex: 0x232528)
+    static let accent     = Color(hex: 0x0A6CFF)
+
+    static let paneHeader: Font = .system(size: 11, weight: .regular)
+    static let rowTitle:   Font = .system(size: 12, weight: .regular)
+    static let rowBold:    Font = .system(size: 12, weight: .semibold)
+    static let rowSmall:   Font = .system(size: 10, weight: .regular)
+    static let deviceName: Font = .system(size: 11, weight: .medium)
+    static let deviceSub:  Font = .system(size: 9.5, weight: .regular)
+}
diff --git a/FreeFileSync/Source/offload/mac/UITest.swift b/FreeFileSync/Source/offload/mac/UITest.swift
new file mode 100644
index 0000000..f60ff9c
--- /dev/null
+++ b/FreeFileSync/Source/offload/mac/UITest.swift
@@ -0,0 +1,111 @@
+// *****************************************************************************
+// * Offload window - click targets and observable state, for the mouse test.   *
+// *                                                                            *
+// * SwiftUI does not act on synthetic NSEvents handed to its hosting view, so   *
+// * the test clicks from outside with real CGEvents. Two halves make that      *
+// * possible and reliable:                                                     *
+// *   - every clickable view publishes its frame here, so the driver never      *
+// *     guesses a control's position;                                          *
+// *   - the app writes those frames plus its state to a JSON file, so the       *
+// *     driver can both aim and check what the click actually did.              *
+// *****************************************************************************
+
+import SwiftUI
+import AppKit
+
+struct AnchorFrames: PreferenceKey
+{
+    static let defaultValue: [String: CGRect] = [:]
+
+    static func reduce(value: inout [String: CGRect], nextValue: () -> [String: CGRect])
+    {
+        value.merge(nextValue()) { _, new in new }
+    }
+}
+
+extension View
+{
+    ///Publishes this view's frame under `id`. A transparent GeometryReader per
+    ///interactive element is the whole cost.
+    @ViewBuilder
+    func testAnchor(_ id: String?) -> some View
+    {
+        if let id
+        {
+            background(
+                GeometryReader { geo in
+                    Color.clear.preference(key: AnchorFrames.self, value: [id: geo.frame(in: .global)])
+                }
+            )
+        }
+        else
+        {
+            self
+        }
+    }
+}
+
+///Writes what the window is showing where a driver can read it.
+@MainActor
+enum UIStateWriter
+{
+    static func write(model: AppModel, window: NSWindow, to path: String)
+    {
+        let contentHeight = window.contentView?.bounds.height ?? window.frame.height
+        let screenHeight = NSScreen.screens.first?.frame.height ?? 0
+
+        var anchors: [String: [String: Double]] = [:]
+        for (id, rect) in model.anchorFrames
+        {
+            //SwiftUI: window content origin, top-left. CGEvent: global display,
+            //top-left. Flip through AppKit's window coordinates to get there.
+            let inWindow = CGPoint(x: rect.midX, y: contentHeight - rect.midY)
+            let screen = window.convertPoint(toScreen: inWindow)
+            anchors[id] = ["x": screen.x,
+                           "y": screenHeight - screen.y,
+                           "w": rect.width,
+                           "h": rect.height]
+        }
+
+        let transfers: [[String: Any]] = model.transfers.map
+        { t in
+            ["destination": t.destination.name,
+             "phase": String(describing: t.phase),
+             "barFraction": t.fraction,
+             "pausedPublished": t.paused,
+             "enginePaused": t.job?.isPaused ?? false,
+             "engineCancelled": t.job?.isCancelled ?? false,
+             "filesDone": t.filesDone,
+             "verified": t.verifiedCount]
+        }
+
+        let payload: [String: Any] = [
+            "pid": ProcessInfo.processInfo.processIdentifier,
+            "window": ["x": window.frame.origin.x, "y": window.frame.origin.y,
+                       "w": window.frame.width, "h": window.frame.height],
+            "anchors": anchors,
+            "selectedSources": model.selectedSources.count,
+            "selectedDestinations": model.selectedDestinations.count,
+            "plannedTransfers": model.plannedTransferCount,
+            "canAddTransfer": model.canAddTransfer,
+            "fitSummary": model.fitSummary.text,
+            "transfers": transfers,
+        ]
+
+        guard let data = try? JSONSerialization.data(withJSONObject: payload,
+                                                     options: [.prettyPrinted, .sortedKeys])
+        else { return }
+        try? data.write(to: URL(fileURLWithPath: path))
+    }
+
+    ///The window's own view hierarchy, so no screen-recording permission is needed.
+    static func capture(_ window: NSWindow, to path: String) -> Bool
+    {
+        guard let view = window.contentView,
+              let rep = view.bitmapImageRepForCachingDisplay(in: view.bounds) else { return false }
+        view.cacheDisplay(in: view.bounds, to: rep)
+        guard let png = rep.representation(using: .png, properties: [:]) else { return false }
+        do { try png.write(to: URL(fileURLWithPath: path)); return true }
+        catch { return false }
+    }
+}
diff --git a/FreeFileSync/Source/offload/mac/Views.swift b/FreeFileSync/Source/offload/mac/Views.swift
new file mode 100644
index 0000000..e693ebf
--- /dev/null
+++ b/FreeFileSync/Source/offload/mac/Views.swift
@@ -0,0 +1,678 @@
+// *****************************************************************************
+// * Offload window - three panes: sources, transfers, destinations.            *
+// *                                                                            *
+// * Layout follows the reference workflow (card on the left, drives on the     *
+// * right, one row per source -> destination in the middle) with original      *
+// * drawing: no vendor artwork is used anywhere.                              *
+// *****************************************************************************
+
+import SwiftUI
+import UniformTypeIdentifiers
+import AppKit
+
+//ImageRenderer lays out without a window, and a ScrollView then renders as an
+//empty viewport. Offscreen snapshots therefore get the same content laid out
+//directly; the running app always scrolls.
+struct SnapshotRenderingKey: EnvironmentKey
+{
+    static let defaultValue = false
+}
+
+extension EnvironmentValues
+{
+    var snapshotRendering: Bool
+    {
+        get { self[SnapshotRenderingKey.self] }
+        set { self[SnapshotRenderingKey.self] = newValue }
+    }
+}
+
+struct RootView: View
+{
+    @ObservedObject var model: AppModel
+
+    var body: some View
+    {
+        HStack(spacing: 0)
+        {
+            DevicePane(title: "Sources",
+                       devices: model.sources,
+                       selection: $model.selectedSources,
+                       isTargeted: $model.isTargetingSources,
+                       showsAddTile: true,
+                       emptyHint: "Drop a card or a folder here",
+                       onAdd: pickSource,
+                       onDropURL: model.addSource,
+                       anchorPrefix: "src")
+            .frame(width: 158)
+
+            separator
+
+            TransfersPane(model: model)
+                .frame(maxWidth: .infinity)
+
+            separator
+
+            DevicePane(title: "Destinations",
+                       devices: model.destinations,
+                       selection: $model.selectedDestinations,
+                       isTargeted: $model.isTargetingDestinations,
+                       showsAddTile: true,
+                       emptyHint: "Drop a drive here",
+                       onAdd: pickDestination,
+                       onDropURL: model.addDestination,
+                       warningFor: { model.warning(for: $0) },
+                       anchorPrefix: "dst")
+            .frame(width: 176)
+        }
+        .padding(.top, 26)
+        .background(Theme.windowBG)
+        .preferredColorScheme(.dark)
+        //published frames, so the mouse-driven UI test can click without guessing
+        .onPreferenceChange(AnchorFrames.self) { model.anchorFrames = $0 }
+    }
+
+    private var separator: some View
+    {
+        Rectangle().fill(Theme.stroke).frame(width: 1)
+    }
+
+    private func pickSource()
+    {
+        for url in openPanel(title: "Choose a card or folder to copy")
+        { model.addSource(url: url) }
+    }
+
+    private func pickDestination()
+    {
+        for url in openPanel(title: "Choose a destination")
+        { model.addDestination(url: url) }
+    }
+
+    private func openPanel(title: String) -> [URL]
+    {
+        let panel = NSOpenPanel()
+        panel.title = title
+        panel.canChooseDirectories = true
+        panel.canChooseFiles = false
+        panel.allowsMultipleSelection = true
+        return panel.runModal() == .OK ? panel.urls : []
+    }
+}
+
+//--- device column -----------------------------------------------------------
+
+struct DevicePane: View
+{
+    let title: String
+    let devices: [Device]
+    @Binding var selection: Set<UUID>
+    @Binding var isTargeted: Bool
+    let showsAddTile: Bool
+    let emptyHint: String
+    let onAdd: () -> Void
+    let onDropURL: (URL) -> Void
+    var warningFor: (Device) -> String? = { _ in nil }
+    var anchorPrefix: String = "device"
+
+    @Environment(\.snapshotRendering) private var snapshotRendering
+
+    private var tiles: some View
+    {
+        VStack(spacing: 14)
+        {
+            if showsAddTile
+            {
+                AddTile(action: onAdd)
+            }
+
+            ForEach(Array(devices.enumerated()), id: \.element.id)
+            { index, device in
+                DeviceTile(device: device,
+                           selected: selection.contains(device.id),
+                           warning: warningFor(device))
+                    .testAnchor("\(anchorPrefix)-tile-\(index)")
+                    .onTapGesture
+                    {
+                        if selection.contains(device.id) { selection.remove(device.id) }
+                        else { selection.insert(device.id) }
+                    }
+            }
+
+            if devices.isEmpty && !showsAddTile
+            {
+                Text(emptyHint)
+                    .font(Theme.rowSmall)
+                    .foregroundColor(Theme.textTertiary)
+                    .multilineTextAlignment(.center)
+                    .padding(.horizontal, 18)
+            }
+        }
+        .padding(.horizontal, 10)
+        .padding(.bottom, 16)
+        .frame(maxWidth: .infinity, alignment: .top)
+    }
+
+    var body: some View
+    {
+        VStack(spacing: 0)
+        {
+            Text(title)
+                .font(Theme.paneHeader)
+                .foregroundColor(Theme.textSecondary)
+                .padding(.top, 12)
+                .padding(.bottom, 10)
+
+            if snapshotRendering
+            {
+                tiles
+            }
+            else
+            {
+                ScrollView { tiles }
+            }
+
+            Spacer(minLength: 0)
+        }
+        .background(Theme.paneBG)
+        .overlay(
+            Rectangle()
+                .strokeBorder(isTargeted ? Theme.accent.opacity(0.8) : .clear, lineWidth: 2)
+        )
+        .onDrop(of: [.fileURL], isTargeted: $isTargeted) { providers in
+            for provider in providers
+            {
+                _ = provider.loadDataRepresentation(forTypeIdentifier: UTType.fileURL.identifier)
+                { data, _ in
+                    guard let data, let url = URL(dataRepresentation: data, relativeTo: nil) else { return }
+                    DispatchQueue.main.async { onDropURL(url) }
+                }
+            }
+            return true
+        }
+    }
+}
+
+struct AddTile: View
+{
+    let action: () -> Void
+
+    var body: some View
+    {
+        Button(action: action)
+        {
+            VStack(spacing: 0)
+            {
+                ZStack
+                {
+                    RoundedRectangle(cornerRadius: 6)
+                        .strokeBorder(Theme.stroke, style: StrokeStyle(lineWidth: 1, dash: [4, 3]))
+                        .frame(width: 62, height: 48)
+
+                    Image(systemName: "plus")
+                        .font(.system(size: 13, weight: .light))
+                        .foregroundColor(Theme.textTertiary)
+                }
+            }
+            .frame(width: 96, height: 62)
+            .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .help("Add a folder or drive")
+    }
+}
+
+struct DeviceTile: View
+{
+    let device: Device
+    let selected: Bool
+    var warning: String? = nil
+
+    private var ringColor: Color
+    {
+        if warning != nil { return Theme.amber }
+        return selected ? Theme.accent.opacity(0.9) : .clear
+    }
+
+    var body: some View
+    {
+        VStack(spacing: 5)
+        {
+            DeviceGlyph(kind: device.kind, width: 60, height: 47)
+
+            Text(device.name)
+                .font(Theme.deviceName)
+                .foregroundColor(selected ? Theme.textPrimary : Theme.textSecondary)
+                .lineLimit(1)
+                .truncationMode(.middle)
+
+            if let warning
+            {
+                Text(warning)
+                    .font(Theme.deviceSub)
+                    .foregroundColor(Theme.amber)
+                    .lineLimit(1)
+                    .minimumScaleFactor(0.8)
+            }
+            else
+            {
+                Text(device.capacityText)
+                    .font(Theme.deviceSub)
+                    .foregroundColor(Theme.textTertiary)
+            }
+        }
+        .frame(width: 104)
+        .padding(.vertical, 7)
+        .background(
+            RoundedRectangle(cornerRadius: 8)
+                .fill(selected ? Color.white.opacity(0.05) : (warning != nil ? Theme.amber.opacity(0.06) : .clear))
+        )
+        .overlay(
+            RoundedRectangle(cornerRadius: 8)
+                .strokeBorder(ringColor, lineWidth: 1)
+        )
+        .contentShape(Rectangle())
+    }
+}
+
+//--- device artwork ----------------------------------------------------------
+//Original shapes: a folder, an SD-style card, and a hard-disk enclosure.
+
+struct DeviceGlyph: View
+{
+    let kind: DeviceKind
+    var width: CGFloat = 60
+    var height: CGFloat = 47
+
+    var body: some View
+    {
+        switch kind
+        {
+        case .folder: folder
+        case .card:   card
+        case .drive:  drive
+        }
+    }
+
+    private var folder: some View
+    {
+        ZStack(alignment: .topLeading)
+        {
+            RoundedRectangle(cornerRadius: 5)
+                .fill(LinearGradient(colors: [Color(hex: 0x7CBCF4), Color(hex: 0x3B86D6)],
+                                     startPoint: .top, endPoint: .bottom))
+                .frame(width: width, height: height * 0.80)
+                .offset(y: height * 0.20)
+
+            RoundedRectangle(cornerRadius: 3)
+                .fill(LinearGradient(colors: [Color(hex: 0x96CCF8), Color(hex: 0x6BAEEA)],
+                                     startPoint: .top, endPoint: .bottom))
+                .frame(width: width * 0.46, height: height * 0.26)
+                .offset(x: 2, y: height * 0.06)
+        }
+        .frame(width: width, height: height, alignment: .topLeading)
+        .shadow(color: .black.opacity(0.45), radius: 3, x: 0, y: 2)
+    }
+
+    private var card: some View
+    {
+        ZStack(alignment: .topLeading)
+        {
+            RoundedRectangle(cornerRadius: 4)
+                .fill(LinearGradient(colors: [Color(hex: 0xF2C64E), Color(hex: 0xD4951A)],
+                                     startPoint: .topLeading, endPoint: .bottomTrailing))
+                .frame(width: width * 0.72, height: height * 0.94)
+
+            //white label band, like the write-protect sticker on a real card
+            RoundedRectangle(cornerRadius: 1.5)
+                .fill(Color(hex: 0xF4F2EC).opacity(0.92))
+                .frame(width: width * 0.52, height: height * 0.26)
+                .offset(x: width * 0.10, y: height * 0.10)
+
+            //contact strip
+            VStack(spacing: 1.5)
+            {
+                ForEach(0..<3, id: \.self) { _ in
+                    RoundedRectangle(cornerRadius: 0.5)
+                        .fill(Color.black.opacity(0.35))
+                        .frame(width: width * 0.34, height: 1.6)
+                }
+            }
+            .offset(x: width * 0.19, y: height * 0.68)
+        }
+        .frame(width: width, height: height)
+        .shadow(color: .black.opacity(0.45), radius: 3, x: 0, y: 2)
+    }
+
+    private var drive: some View
+    {
+        ZStack(alignment: .topLeading)
+        {
+            RoundedRectangle(cornerRadius: 4)
+                .fill(LinearGradient(colors: [Color(hex: 0xEDEFF2), Color(hex: 0xAEB4BB)],
+                                     startPoint: .topLeading, endPoint: .bottomTrailing))
+                .frame(width: width * 0.94, height: height * 0.92)
+
+            RoundedRectangle(cornerRadius: 4)
+                .fill(Color(hex: 0xD3D7DC))
+                .frame(width: width * 0.94, height: height * 0.20)
+
+            HStack(spacing: 3)
+            {
+                Circle().fill(Theme.green.opacity(0.9)).frame(width: 3.5, height: 3.5)
+                Capsule().fill(Color.black.opacity(0.10)).frame(width: width * 0.30, height: 2)
+            }
+            .offset(x: width * 0.08, y: height * 0.68)
+        }
+        .frame(width: width, height: height)
+        .shadow(color: .black.opacity(0.5), radius: 3, x: 0, y: 2)
+    }
+}
+
+//--- transfers ---------------------------------------------------------------
+
+struct TransfersPane: View
+{
