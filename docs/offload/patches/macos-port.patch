     //--------------------------------------------------------------
     //waitpid() is a useless pile of garbage without time out => check EOF from dummy pipe instead
     int pipe[2] = {};
+#if defined(__APPLE__)
+    if (::pipe(pipe) != 0)
+        THROW_LAST_SYS_ERROR("pipe");
+    for (const int fd : pipe)
